from functools import lru_cache

from langchain_core.tools import tool

from aoc_runtime.config import DATA_DIR
from rag.indexer import build_store


@lru_cache
def _store():
    return build_store(DATA_DIR / "docs" / "{{module}}")


@tool
def rag_search(query: str) -> str:
    """Search the {{title}} knowledge base and return the top passages."""
    hits = _store().search(query, k=3)
    return "\n---\n".join(f"[{h.source}] {h.text}" for h in hits) or "no results"


@tool
def lookup_status(reference: str) -> str:
    """Look up the status of a request by its reference. TODO: call your real system here."""
    return f"status for {reference}: not implemented yet"


TOOLS = [rag_search, lookup_status]
