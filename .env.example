# Copy to .env and fill in. Never commit .env.

# --- LLM providers (tried in this order; "fake" needs no key) ---
AOC_LLM_PROVIDERS=gemini,groq,fake
GOOGLE_API_KEY=            # https://aistudio.google.com/apikey (free tier)
GROQ_API_KEY=              # https://console.groq.com/keys (free tier)
AOC_GEMINI_MODEL=gemini-2.5-flash
AOC_GROQ_MODEL=llama-3.3-70b-versatile
AOC_OLLAMA_MODEL=qwen2.5:3b

# --- Environment / tagging ---
AOC_ENV=dev
AOC_TENANT=snackco-supply

# --- Telemetry ---
# Collector (docker compose) listens on 4318; Phoenix directly accepts OTLP on 6006.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
AOC_TELEMETRY_ENABLED=true

# --- RAG ---
AOC_VECTOR_STORE=local     # local | pgvector
AOC_EMBEDDER=fastembed     # fastembed | hash (hash = offline, test only)
AOC_PG_DSN=postgresql://aoc:aoc@localhost:5432/aoc
